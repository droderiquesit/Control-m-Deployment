# ---------------------------------------------------------------------------
# Control-M/Agent (scale-set instance) — THIN role stub appended to the
# common shim by ctmdeploy render.py. The agent software is BAKED into the
# ctm-agent golden image (packer/ctm-agent.pkr.hcl) — no media download, no
# install at boot. This stub writes /etc/ctm/node.json (names/ids ONLY,
# never secrets) and runs the idempotent python installer, which waits for
# the EM Automation API, CONFIGURES the baked agent (server name/ports/
# hostname), starts it, registers it to its Server's host group through the
# EM REST API (urllib — Node.js is no longer needed at runtime; it stays in
# the golden image as an optional convenience) and starts the scheduled-
# events watcher that deregisters the agent gracefully on Terminate/Preempt.
# ---------------------------------------------------------------------------
cat > /etc/ctm/node.json <<'NODEJSON'
{
  "role": "__ROLE__",
  "environment": "__ENVIRONMENT__",
  "key_vault_name": "__KEY_VAULT_NAME__",
  "identity_client_id": "__IDENTITY_CLIENT_ID__",
  "blob_account": "__BLOB_ACCOUNT__",
  "installers_container": "__INSTALLERS_CONTAINER__",
  "backups_container": "__BACKUPS_CONTAINER__",
  "nfs_server": "__NFS_SERVER__",
  "nfs_export": "__NFS_EXPORT__",
  "data_mount": "__DATA_MOUNT__",
  "ctm_version": "__CTM_VERSION__",
  "dns_zone": "__DNS_ZONE__",
  "agent_user": "__AGENT_USER__",
  "em_api_endpoint": "__EM_API_ENDPOINT__",
  "em_api_user": "__EM_API_USER__",
  "ctm_server_name": "__CTM_SERVER_NAME__",
  "hostgroup": "__HOSTGROUP__",
  "agent_port": "__AGENT_PORT__",
  "provision_image": "__PROVISION_IMAGE__",
  "server_primary_host": "__SERVER_PRIMARY_HOST__"
}
NODEJSON
run_node_installer
