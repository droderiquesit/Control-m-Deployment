# ---------------------------------------------------------------------------
# Control-M/Agent (scale-set instance). Provisioned through the Automation API
# hosted by Control-M/EM, registered to the Server and added to a host group.
# Deregisters itself when Azure delivers a Terminate/Preempt scheduled event.
# Node.js 20 is baked into the ctm-rhel9 golden image (packer/scripts/).
# ---------------------------------------------------------------------------
AGENT_USER="__AGENT_USER__"
AGENT_HOME="/home/$AGENT_USER"
EM_API="__EM_API_ENDPOINT__"
EM_API_USER="__EM_API_USER__"
CTM_SERVER_NAME="__CTM_SERVER_NAME__"
HOSTGROUP="__HOSTGROUP__"
AGENT_PORT="__AGENT_PORT__"
PROVISION_IMAGE="__PROVISION_IMAGE__"
AGENT_NAME="$(hostname -s)"

id -u "$AGENT_USER" >/dev/null 2>&1 || useradd -m -d "$AGENT_HOME" -s /bin/bash "$AGENT_USER"

# Automation API CLI (node.js, preinstalled in the golden image). The CLI
# tarball is served by EM itself.
# EM ships a self-signed certificate by default; replace with a CA-signed one
# and drop -k / NODE_TLS_REJECT_UNAUTHORIZED in production.
wait_for 1800 curl -sSfk -o /tmp/ctm-cli.tgz "$EM_API/ctm-cli.tgz"
npm install -g /tmp/ctm-cli.tgz
EM_ADMIN_PASSWORD=$(kv_secret em-admin-password)

cat > /etc/profile.d/ctm-agent.sh <<PROFILE
export NODE_TLS_REJECT_UNAUTHORIZED=0
PROFILE

su - "$AGENT_USER" -c "export NODE_TLS_REJECT_UNAUTHORIZED=0; \
  ctm env add ctmenv '$EM_API' '$EM_API_USER' '$EM_ADMIN_PASSWORD' >/dev/null && ctm env set ctmenv >/dev/null"

# Provision the agent image from EM and register it with the Server + host group.
# (Validate the exact sub-commands against 'ctm provision -h' for your release.)
su - "$AGENT_USER" -c "export NODE_TLS_REJECT_UNAUTHORIZED=0; \
  ctm provision image '$PROVISION_IMAGE' && \
  ctm provision agent::setup '$CTM_SERVER_NAME' '$AGENT_NAME' '$AGENT_PORT' && \
  ctm config server:hostgroup:agent::add '$CTM_SERVER_NAME' '$HOSTGROUP' '$AGENT_NAME'"

# Deregistration script used by the scheduled-events watcher.
cat > /usr/local/sbin/ctm-agent-deregister.sh <<DEREG
#!/usr/bin/env bash
set -uo pipefail
su - $AGENT_USER -c "export NODE_TLS_REJECT_UNAUTHORIZED=0; \
  ctm config server:hostgroup:agent::delete '$CTM_SERVER_NAME' '$HOSTGROUP' '$AGENT_NAME'; \
  ctm config server:agent::delete '$CTM_SERVER_NAME' '$AGENT_NAME'; \
  shut-ag -u $AGENT_USER -p all || true"
DEREG
chmod 0750 /usr/local/sbin/ctm-agent-deregister.sh

# Azure Scheduled Events watcher: on Terminate/Preempt, deregister then approve.
cat > /usr/local/sbin/ctm-scheduled-events.sh <<'WATCH'
#!/usr/bin/env bash
set -uo pipefail
IMDS="http://169.254.169.254/metadata"
SELF=$(curl -sS -H "Metadata: true" "$IMDS/instance/compute/name?api-version=2021-02-01&format=text" | tr '[:upper:]' '[:lower:]')
while true; do
  EV=$(curl -sS -H "Metadata: true" "$IMDS/scheduledevents?api-version=2020-07-01" || echo '{}')
  for ID in $(echo "$EV" | jq -r --arg self "$SELF" \
      '.Events[]? | select(.EventType=="Terminate" or .EventType=="Preempt")
       | select([.Resources[] | ascii_downcase | ltrimstr("_")] | index($self) != null) | .EventId'); do
    logger -t ctm-agent "scheduled event $ID -> deregistering agent"
    /usr/local/sbin/ctm-agent-deregister.sh
    curl -sS -H "Metadata: true" -H "Content-Type: application/json" \
      -d "{\"StartRequests\":[{\"EventId\":\"$ID\"}]}" "$IMDS/scheduledevents?api-version=2020-07-01" >/dev/null
    touch /var/lib/ctm/deregistered
  done
  sleep 10
done
WATCH
chmod 0750 /usr/local/sbin/ctm-scheduled-events.sh

cat > /etc/systemd/system/ctm-scheduled-events.service <<'UNIT'
[Unit]
Description=Control-M agent scheduled-events watcher (graceful deregistration)
After=network-online.target

[Service]
ExecStart=/usr/local/sbin/ctm-scheduled-events.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now ctm-scheduled-events.service

date -u +%FT%TZ > "$MARKER"
echo "== Control-M/Agent bootstrap finished ($AGENT_NAME -> $CTM_SERVER_NAME/$HOSTGROUP)"
