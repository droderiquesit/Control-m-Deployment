# ---------------------------------------------------------------------------
# Control-M/Server node (__SERVER_ROLE__). Appended to the common section by
# ctmdeploy render.py. Primary runs the scheduler (ctm) + Configuration Agent
# (ca). Secondary runs only the CA and waits for failover (same database).
# ---------------------------------------------------------------------------
SERVER_ROLE="__SERVER_ROLE__"
CTM_USER="__CTM_USER__"
CTM_HOME="$DATA_MOUNT/$CTM_USER"
SERVER_INSTALLER_BLOB="__SERVER_INSTALLER_BLOB__"
SERVER_SILENT_BLOB="__SERVER_SILENT_BLOB__"
DB_HOST="__DB_HOST__"
DB_PORT="__DB_PORT__"
CTM_DB_NAME="__CTM_DB_NAME__"
CTM_DB_USER="__CTM_DB_USER__"
CTM_DB_SECRET_NAME="__CTM_DB_SECRET_NAME__"
DB_ADMIN_USER="__DB_ADMIN_USER__"
CTM_SERVER_NAME="__CTM_SERVER_NAME__"
SERVER_PRIMARY_HOST="__SERVER_PRIMARY_HOST__"
SERVER_SECONDARY_HOST="__SERVER_SECONDARY_HOST__"
EM_HOST="__EM_HOST__"

id -u "$CTM_USER" >/dev/null 2>&1 || useradd -m -d "$CTM_HOME" -s /bin/bash "$CTM_USER"
mkdir -p "$CTM_HOME" && chown "$CTM_USER":"$CTM_USER" "$CTM_HOME"

if [ -f "$CTM_HOME/.ctm_installed" ]; then
  echo "Control-M/Server already installed on persistent disk; starting services only"
else
  DB_ADMIN_PASSWORD=$(kv_secret db-admin-password)
  CTM_DB_PASSWORD=$(kv_secret "$CTM_DB_SECRET_NAME")

  if [ "$SERVER_ROLE" = "secondary" ]; then
    echo "== secondary: waiting for primary Control-M/Server ($SERVER_PRIMARY_HOST) Configuration Agent (2369)"
    wait_for 7200 bash -c "exec 3<>/dev/tcp/$SERVER_PRIMARY_HOST/2369"
  fi

  INSTALL_SRC="$SHARED_MOUNT/installers/server/$CTM_VERSION"
  if [ ! -f "$INSTALL_SRC/.extracted" ]; then
    mkdir -p "$INSTALL_SRC"
    blob_get "$SERVER_INSTALLER_BLOB" /tmp/server-installer.bin
    tar -xf /tmp/server-installer.bin -C "$INSTALL_SRC"
    rm -f /tmp/server-installer.bin
    touch "$INSTALL_SRC/.extracted"
  fi
  chown -R "$CTM_USER":"$CTM_USER" "$INSTALL_SRC"

  # Silent-install XML placeholders are substituted here. U builds the XML's
  # two-underscore placeholders at runtime so they never look like render
  # tokens (the renderer rejects leftover token-shaped text).
  U='__'
  blob_get "$SERVER_SILENT_BLOB" /tmp/server-silent.xml
  sed -i \
    -e "s|${U}DB_HOST${U}|$DB_HOST|g" \
    -e "s|${U}DB_PORT${U}|$DB_PORT|g" \
    -e "s|${U}DB_NAME${U}|$CTM_DB_NAME|g" \
    -e "s|${U}DB_ADMIN_USER${U}|$DB_ADMIN_USER|g" \
    -e "s|${U}DB_ADMIN_PASSWORD${U}|$DB_ADMIN_PASSWORD|g" \
    -e "s|${U}CTM_DB_USER${U}|$CTM_DB_USER|g" \
    -e "s|${U}CTM_DB_PASSWORD${U}|$CTM_DB_PASSWORD|g" \
    -e "s|${U}CTM_HOME${U}|$CTM_HOME|g" \
    -e "s|${U}CTM_USER${U}|$CTM_USER|g" \
    -e "s|${U}CTM_SERVER_NAME${U}|$CTM_SERVER_NAME|g" \
    -e "s|${U}HOSTNAME${U}|$(hostname -s)|g" \
    -e "s|${U}PRIMARY_HOST${U}|$SERVER_PRIMARY_HOST|g" \
    -e "s|${U}SECONDARY_HOST${U}|$SERVER_SECONDARY_HOST|g" \
    -e "s|${U}EM_HOST${U}|$EM_HOST|g" \
    /tmp/server-silent.xml
  chown "$CTM_USER":"$CTM_USER" /tmp/server-silent.xml && chmod 600 /tmp/server-silent.xml

  SETUP=$(find "$INSTALL_SRC" -maxdepth 2 -name setup.sh | head -n1)
  [ -n "$SETUP" ] || { echo "setup.sh not found under $INSTALL_SRC"; exit 1; }
  echo "== installing Control-M/Server ($SERVER_ROLE) from $SETUP"
  su - "$CTM_USER" -c "$SETUP -silent /tmp/server-silent.xml"
  rm -f /tmp/server-silent.xml
  touch "$CTM_HOME/.ctm_installed"
fi

if [ "$SERVER_ROLE" = "primary" ]; then
  START_CMD='start_ca; start_ctm'
  STOP_CMD='shut_ctm; shut_ca'
else
  START_CMD='start_ca'
  STOP_CMD='shut_ca'
fi

cat > /etc/systemd/system/controlm-server.service <<UNIT
[Unit]
Description=Control-M/Server ($SERVER_ROLE)
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=forking
User=$CTM_USER
WorkingDirectory=$CTM_HOME
ExecStart=/bin/bash -lc '$START_CMD'
ExecStop=/bin/bash -lc '$STOP_CMD'
TimeoutStartSec=600
TimeoutStopSec=300
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now controlm-server.service || true

date -u +%FT%TZ > "$MARKER"
echo "== Control-M/Server bootstrap finished"
