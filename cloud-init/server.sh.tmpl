# ---------------------------------------------------------------------------
# Control-M/Server node (__SERVER_ROLE__) — THIN role stub appended to the
# common shim by ctmdeploy render.py. Writes /etc/ctm/node.json (names/ids
# ONLY, never secrets) and runs the idempotent python installer, which waits
# for the primary (secondary nodes), pulls secrets from Key Vault in-memory,
# caches the media on NFS, renders the silent XML, runs setup.sh and installs
# the controlm-server.service unit (primary: start_ca; start_ctm — secondary:
# start_ca only).
# ---------------------------------------------------------------------------
cat > /etc/ctm/node.json <<'NODEJSON'
{
  "role": "__ROLE__",
  "environment": "__ENVIRONMENT__",
  "key_vault_name": "__KEY_VAULT_NAME__",
  "identity_client_id": "__IDENTITY_CLIENT_ID__",
  "blob_account": "__BLOB_ACCOUNT__",
  "installers_container": "__INSTALLERS_CONTAINER__",
  "backups_container": "__BACKUPS_CONTAINER__",
  "nfs_server": "__NFS_SERVER__",
  "nfs_export": "__NFS_EXPORT__",
  "data_mount": "__DATA_MOUNT__",
  "ctm_version": "__CTM_VERSION__",
  "dns_zone": "__DNS_ZONE__",
  "server_role": "__SERVER_ROLE__",
  "ctm_user": "__CTM_USER__",
  "server_installer_blob": "__SERVER_INSTALLER_BLOB__",
  "server_silent_blob": "__SERVER_SILENT_BLOB__",
  "db_host": "__DB_HOST__",
  "db_port": "__DB_PORT__",
  "ctm_db_name": "__CTM_DB_NAME__",
  "ctm_db_user": "__CTM_DB_USER__",
  "ctm_db_secret_name": "__CTM_DB_SECRET_NAME__",
  "db_admin_user": "__DB_ADMIN_USER__",
  "ctm_server_name": "__CTM_SERVER_NAME__",
  "server_primary_host": "__SERVER_PRIMARY_HOST__",
  "server_secondary_host": "__SERVER_SECONDARY_HOST__",
  "em_host": "__EM_HOST__"
}
NODEJSON
run_node_installer
