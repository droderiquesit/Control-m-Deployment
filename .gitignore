# Terraform
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Secrets / local overrides (never commit)
*.secret.tfvars
*.auto.tfvars.local
.env
# Azure Functions local settings can hold real connection strings/secrets
# (functions/kvsync); .funcignore and `ctmdeploy kvsync deploy` also exclude it.
local.settings.json

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Python (ctmdeploy)
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/

# Packer
packer_cache/
packer/*.pkrvars.hcl

# Bicep build artifacts (bicep build without --stdout)
bicep/**/*.json
